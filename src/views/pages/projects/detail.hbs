<main>
  <section class="container-fluid bg-body-secondary py-5" id="detailProject">
    <!-- Detail Project -->
    <div class="container">
      <h1 class="text-center mb-4">{{project.projectName}}</h1>

      <div class="row align-items-center g-4">
        <!-- Image -->
        <div class="col-12 col-md-6">
          <img
            src="/public/images/code.jpg"
            alt="code image"
            class="img-fluid rounded"
            style="height: 300px; width: 100%; object-fit: cover;"
          />
        </div>

        <!-- Detail Info -->
        <div class="col-12 col-md-6">
          <div class="d-flex flex-column gap-4">
            <!-- Duration -->
            <div>
              <h4>Duration</h4>

              <p class="mb-1">
                <i class="fa-regular fa-calendar-days me-2 text-secondary"></i>
                12 Jan 2026 - 11 Feb 2026
              </p>

              <p class="fw-semibold">
                <i class="fa-solid fa-hourglass-half me-2 text-secondary"></i>
                1 Month
              </p>
            </div>

            <!-- Technologies -->
            <div>
              <h4>Technologies</h4>

              <div class="row row-cols-2 g-2">
                {{#each project.technologies as |t|}}
                  <div class="col">
                    <p class="mb-0 text-capitalize">
                      <img
                        src="{{t.url}}"
                        alt="programming icon"
                        width="30px"
                      />

                      {{t.name}}
                    </p>
                  </div>
                {{/each}}
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Description -->
      <p class="mt-4">
        {{project.description}}
      </p>
    </div>
  </section>
</main>