<main>
  <section class="container-fluid bg-body-secondary py-5">
    <!-- Form add my project -->
    <div class="container">
      <h1 class="text-center">ADD MY PROJECT</h1>
      <form
        action="/projects"
        id="addProject"
        class="d-flex"
        method="post"
        style="flex-direction: column"
      >
        <div class="mb-3">
          <label for="projectName" class="form-label">Project Name</label>
          <input
            type="text"
            class="form-control"
            id="projectName"
            name="projectName"
          />
        </div>
        <div class="d-flex justify-content-start gap-3 flex-md-row flex-column">
          <div class="mb-3">
            <label for="startDate" class="form-label">Start Date</label>
            <input
              type="date"
              class="form-control"
              id="startDate"
              name="start_date"
            />
          </div>
          <div class="mb-3">
            <label for="endDate" class="form-label">End Date</label>
            <input
              type="date"
              class="form-control"
              id="endDate"
              name="end_date"
            />
          </div>
          <div class="mb-3">
            <label class="form-label">Teknologies</label>
            <div class="d-flex justify-content-between flex-wrap gap-2">
              <div class="form-check">
                <input
                  class="form-check-input"
                  type="checkbox"
                  name="technologies"
                  value="node-js"
                  id="nodeJs"
                />
                <label class="form-check-label" for="nodeJs">
                  <small class="text-secondary">Node Js</small>
                </label>
              </div>
              <div class="form-check">
                <input
                  class="form-check-input"
                  type="checkbox"
                  name="technologies"
                  value="next-js"
                  id="nextJs"
                />
                <label class="form-check-label" for="nextJs">
                  <small class="text-secondary">Next Js</small>
                </label>
              </div>
              <div class="form-check">
                <input
                  class="form-check-input"
                  type="checkbox"
                  name="technologies"
                  value="react-js"
                  id="reactJs"
                />
                <label class="form-check-label" for="reactJs">
                  <small class="text-secondary">React Js</small>
                </label>
              </div>
              <div class="form-check">
                <input
                  class="form-check-input"
                  type="checkbox"
                  name="technologies"
                  value="typeScript"
                  id="typeScript"
                />
                <label class="form-check-label" for="typeScript">
                  <small class="text-secondary">TypeScript</small>
                </label>
              </div>
            </div>
          </div>
        </div>
        <div class="mb-3">
          <label for="description" class="form-label">Description</label>
          <textarea
            class="form-control"
            id="description"
            name="description"
            rows="6"
          ></textarea>
        </div>
        <div class="mb-3 pt-2">
          <label for="uploadImage" class="form-label">Upload Image</label>
          <input
            type="file"
            class="form-control"
            name="image"
            id="uploadImage"
          />
        </div>
        <div class="mb-3 pt-3 d-flex justify-content-end">
          <button
            type="submit"
            class="btn btn-primary"
            style="width: 200px"
            id="submitButton"
          >
            Send
          </button>
        </div>
      </form>
    </div>
  </section>

  <!-- My Project -->
  <section class="container-fluid bg-body-light py-5">
    <div class="container">
      <h1 class="text-center">MY PROJECT</h1>
      <div class="content mt-4">
        <div
          id="cardList"
          class="d-flex gap-3 flex-wrap justify-content-center"
        >
          {{#each projects as |project|}}
            <div class="card" style="width: 18rem">
              <img
                src="/public/images/code.jpg"
                class="card-img-top"
                height="150px"
                alt="Code Image"
                style="object-fit: cover;"
              />
              <div class="card-body">
                <a
                  href="/projects/{{project.id}}"
                  class="card-title text-decoration-none"
                >
                  <h5>{{project.projectName}}</h5>
                </a>
                <h6 class="card-subtitle mb-2 text-body-secondary">
                  <small> Durasi: 3 bulan </small>
                </h6>
                <p class="card-text">
                  {{project.description}}
                </p>
                <a href="#" class="btn btn-primary">Edit</a>
                <a href="#" class="btn btn-primary">Delete</a>
              </div>
            </div>
          {{/each}}
        </div>
      </div>
    </div>
  </section>
</main>