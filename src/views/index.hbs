<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ title }}</title>

    {{> head}}

    <link rel="stylesheet" href="/public/css/style.css" />
  </head>

  <body>
    {{> navbar}}
    
    {{{body}}}

    {{> modalAuthentication}}

    <div class="toast-container position-fixed top-0 end-0 p-3" id="toastMessage">
      {{#if success}}
        <div class="toast show align-items-center text-bg-success border-0">
          <div class="d-flex">
            <div class="toast-body">
              {{success}}
            </div>
            <button
              class="btn-close btn-close-white me-2 m-auto"
              data-bs-dismiss="toast"
            ></button>
          </div>
        </div>
      {{/if}}

      {{#if error}}
        <div class="toast show align-items-center text-bg-danger border-0">
          <div class="d-flex">
            <div class="toast-body">
              {{error}}
            </div>
            <button
              class="btn-close btn-close-white me-2 m-auto"
              data-bs-dismiss="toast"
            ></button>
          </div>
        </div>
      {{/if}}
    </div>

    <script src="/public/js/auth_modal.js"></script>
  </body>
</html>